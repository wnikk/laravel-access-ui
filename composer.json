{
    "name": "wnikk/laravel-access-ui",
    "version": "3.0.0",
    "description": "Administration screens for wnikk/laravel-access-rules 3.x: rules, owners, permissions with conditions, inheritance, explain, health and XACML. One script, one stylesheet, no CDN.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "permissions",
        "roles",
        "acl",
        "rbac",
        "abac",
        "access-control",
        "admin",
        "ui",
        "vue",
        "xacml"
    ],
    "authors": [
        {
            "name": "Nikolay May",
            "homepage": "https://nikk.dev",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/wnikk/laravel-access-ui",
    "bugs": {
        "url": "https://github.com/wnikk/laravel-access-ui/issues"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "wnikk/laravel-access-rules": "^3.2.4"
    },
    "require-dev": {
        "orchestra/testbench": "*",
        "phpunit/phpunit": "*"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Wnikk\\LaravelAccessUi\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wnikk\\LaravelAccessUi\\AccessUiServiceProvider"
            ]
        }
    }
}
