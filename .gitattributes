# Normalize line endings
* text=auto eol=lf

*.php diff=php
*.md  diff=markdown

# Files and folders excluded from release archives (composer dist / "Download ZIP"):
# only what an application needs at runtime stays in vendor/. The built bundle in dist/ ships,
# its sources do not.
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.github            export-ignore
/_dev               export-ignore
/AGENTS.md          export-ignore
/docs               export-ignore
/tests              export-ignore
/phpunit.xml        export-ignore
/pint.json          export-ignore
/CHANGELOG.md       export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/vite.config.js     export-ignore
/resources/js       export-ignore
/resources/vue      export-ignore
/resources/css      export-ignore
